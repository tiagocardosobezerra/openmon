{
  "name": "openmon",
  "version": "0.2.1",
  "description": "A desktop pet that grows from the work your AI coding agent does, and tells you when it needs you.",
  "license": "MIT",
  "bin": {
    "openmon": "bin/openmon.js"
  },
  "main": "src/electron-main.js",
  "files": [
    "bin",
    "src",
    "public",
    "docs",
    "art",
    "assets",
    "README.en.md",
    "!docs/screens"
  ],
  "scripts": {
    "start": "node bin/openmon.js start --foreground",
    "serve": "node bin/openmon.js serve",
    "demo": "node bin/openmon.js demo",
    "test": "node --test \"test/*.test.js\"",
    "smoke": "node test/smoke.js",
    "brand": "node tools/build-brand.js",
    "screens": "node tools/screens.js",
    "banner": "node tools/build-banner.js",
    "dist": "node tools/dist.js",
    "dist:dir": "node tools/dist.js --dir"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron": "^33.0.0"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agent",
    "hooks",
    "desktop-pet",
    "tamagotchi",
    "virtual-pet",
    "ai-agents",
    "electron"
  ],
  "allowScripts": {
    "electron@33.4.11": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiagocardosobezerra/openmon.git"
  },
  "homepage": "https://github.com/tiagocardosobezerra/openmon#readme",
  "bugs": {
    "url": "https://github.com/tiagocardosobezerra/openmon/issues"
  },
  "devDependencies": {
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.openmon.app",
    "productName": "Openmon",
    "directories": {
      "output": "dist"
    },
    "files": [
      "bin/**",
      "src/**",
      "public/**",
      "art/**",
      "assets/brand/**",
      "package.json",
      "!**/*.test.js"
    ],
    "asarUnpack": [
      "src/hook.js",
      "src/focus.js",
      "src/adapters.js",
      "src/opencode-plugin.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/brand/app-icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Openmon-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/brand/app-icon-1024.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/brand/app-icon-1024.png",
      "category": "Development"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tiagocardosobezerra",
        "repo": "openmon",
        "releaseType": "release"
      }
    ]
  },
  "author": "Tiago Cardoso Bezerra"
}
